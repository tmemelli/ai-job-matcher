# Configurações da Aplicação
PROJECT_NAME=AI Job Matcher Pro
VERSION=1.0.0
ENV=development

# Banco de Dados (Uso Futuro)
DATABASE_URL=sqlite:///./ai_job_matcher.db

# Configurações da OpenAI (Obrigatório para o Chat/Análise)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua-chave-openai-aqui-sem-aspas

# Modelo de IA (Padrão: gpt-4o)
OPENAI_MODEL=gpt-4o-2024-08-06

# Senha de Segurança (Para acessar a tela do sistema)
APP_PASSWORD=defina-sua-senha-aqui