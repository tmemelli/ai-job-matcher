# ============================================================
# AI Job Matcher Pro - Configuração
# ============================================================

# Configurações da Aplicação
PROJECT_NAME=AI Job Matcher Pro
VERSION=2.0.0
ENV=development

# ============================================================
# OBRIGATÓRIO: OpenAI (para análise principal)
# ============================================================
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_MODEL=gpt-4o-2024-08-06

# ============================================================
# OBRIGATÓRIO: Senha do App
# ============================================================
APP_PASSWORD=sua-senha-segura

# ============================================================
# BUSCA WEB: Escolha pelo menos um provider
# ============================================================

# OPÇÃO 1: Tavily (Recomendado - melhor para buscas profissionais)
# Obtenha em: https://tavily.com (1000 buscas grátis/mês)
TAVILY_API_KEY=tvly-sua-chave-aqui

# OPÇÃO 2: Serper.dev (Google Search API)
# Obtenha em: https://serper.dev (2500 buscas grátis/mês)
SERPER_API_KEY=sua-chave-serper

# OPÇÃO 3: DuckDuckGo
# Não precisa de API key! Funciona automaticamente como fallback.

# ============================================================
# OPCIONAL: GitHub Token (para mais requisições)
# ============================================================
# Sem token: 60 requisições/hora
# Com token: 5000 requisições/hora
# Crie em: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_seu-token-aqui

# ============================================================
# OPCIONAL: Google Gemini (alternativa ao OpenAI)
# ============================================================
# Obtenha em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua-chave-google

# ============================================================
# Banco de Dados (Uso Futuro)
# ============================================================
DATABASE_URL=sqlite:///./ai_job_matcher.db
